#!/usr/bin/env bash
#
# render-all-diagrams — рендерит все mermaid-диаграммы из docs/architecture/.
#
# Работу делает scripts/render-diagrams; этот скрипт лишь собирает md-файлы
# с блоками ```mermaid и передаёт их списком (render-diagrams принимает
# только явные пути — так его проще переиспользовать для выбранных файлов).
#
# Usage:
#     scripts/render-all-diagrams [--format=png|svg]   # флаги пробрасываются
#
# Код возврата — как у scripts/render-diagrams (0 — всё отрендерилось).

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
arch_dir="$repo_root/docs/architecture"

# grep -l отбирает только md с блоком ```mermaid: файлы без диаграмм
# рендерить бессмысленно — mmdc упал бы или дал пустой артефакт.
mapfile -t diagrams < <(grep -l '```mermaid' "$arch_dir"/*.md 2>/dev/null)

if [ "${#diagrams[@]}" -eq 0 ]; then
    echo "Нет mermaid-диаграмм в $arch_dir" >&2
    exit 1
fi

exec python3 "$repo_root/scripts/render-diagrams" "$@" "${diagrams[@]}"
